# ============================================
# SIMS Backend - Environment Variables Template
# ============================================
# Copy this file to .env and fill in the values

NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_NAME=SIMS-Backend

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sims_db?schema=public"

JWT_ACCESS_SECRET=change-me-to-a-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-random-string-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

BCRYPT_SALT_ROUNDS=12

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

CORS_ORIGIN=http://localhost:5173

MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

AI_SERVICE_URL=http://localhost:8000

LOG_LEVEL=debug
